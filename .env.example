# Usado pelo docker-compose.yml (todos os serviços leem este arquivo via
# `env_file`). Copie para .env antes de subir o projeto:
#
#   cp .env.example .env
#
# Depois defina POSTGRES_PASSWORD e JWT_SECRET_KEY com valores fortes
# (gere uma chave para JWT_SECRET_KEY com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))")

POSTGRES_DB=siamp_db
POSTGRES_USER=siamp_user
POSTGRES_PASSWORD=troque-por-uma-senha-forte

JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480

# Cookie httpOnly de sessão (ver backend/app/api/v1/auth.py). Navegadores
# só aceitam cookies "Secure" em conexões HTTPS - como o fluxo padrão
# deste README roda tudo em http://localhost, isto vem como "false" aqui.
# Em produção atrás de HTTPS, mude para "true".
COOKIE_SECURE=false

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Endereço remetente (From:). Em provedores transacionais (Brevo,
# SendGrid etc.), o SMTP_USER costuma ser só um token de autenticação,
# diferente do endereço validado como remetente - nesses casos, defina
# SMTP_FROM com o endereço que você validou no painel do provedor. Se
# não definida, usa o mesmo valor de SMTP_USER (caso comum do Gmail,
# onde os dois são o mesmo e-mail).
SMTP_FROM=
# Chave da API HTTP do Brevo (não a chave SMTP) - alternativa ao SMTP
# acima, necessária em hospedagens que bloqueiam portas SMTP de saída
# no plano gratuito (ex.: Render). Quando definida, tem prioridade
# sobre SMTP_USER/SMTP_PASS. Gere em Settings > SMTP & API > API Keys
# no painel do Brevo. Deixe em branco para usar SMTP normalmente
# (bom para desenvolvimento local).
BREVO_API_KEY=
REPORT_RECIPIENTS=gerente.producao@empresa.com,supervisao@empresa.com

CORS_ORIGINS=http://localhost:8090,http://localhost:5173,http://localhost:5500

SEED_ON_START=true
