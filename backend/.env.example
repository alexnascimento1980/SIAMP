# Usado quando o backend roda fora do Docker Compose (ex. localmente
# com `uvicorn app.main:app --reload`). Copie para backend/.env.

DATABASE_URL=postgresql+psycopg2://siamp_user:troque-por-uma-senha-forte@localhost:5432/siamp_db

JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480

# Cookie httpOnly de sessão. Navegadores só aceitam cookies "Secure" em
# HTTPS; para rodar localmente sem TLS (ex. uvicorn --reload) deixe
# "false". Em produção atrás de HTTPS, mude para "true".
COOKIE_SECURE=false

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Ver .env.example (raiz) para explicação - usada quando o usuário de
# autenticação SMTP difere do remetente (ex.: provedores transacionais).
SMTP_FROM=
# Chave da API HTTP do Brevo (não a chave SMTP) - ver .env.example
# (raiz) para explicação. Tem prioridade sobre SMTP_USER/SMTP_PASS.
BREVO_API_KEY=
REPORT_RECIPIENTS=gerente.producao@empresa.com,supervisao@empresa.com

CORS_ORIGINS=http://localhost:5173,http://localhost:5500

SEED_ON_START=false
