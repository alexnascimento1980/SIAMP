server {
    # Render injeta a variável de ambiente PORT dinamicamente - o nginx
    # não lê variáveis de ambiente nativamente, então este valor é
    # substituído em tempo de execução por deploy/start.sh (via
    # envsubst), igual ao BACKEND_INTERNAL_URL do
    # frontend/nginx.conf.template usado no docker-compose local.
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index login.html;

    # Cabeçalhos de segurança. script-src NÃO tem 'unsafe-inline': as
    # telas não usam mais handlers inline (onclick=...) nem <script>
    # inline - os eventos são ligados por js/acoes.js. Só executa script
    # do próprio site e do jsDelivr (versão fixa + SRI nos HTML).
    # style-src mantém 'unsafe-inline' por causa de atributos style="..."
    # (risco bem menor que script).
    # IMPORTANTE: add_header em um bloco location substitui (não soma
    # com) os do nível server - por isso o location de js/css repete
    # os cabeçalhos abaixo.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), payment=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # O backend roda no mesmo container, escutando só em 127.0.0.1
    # (nunca exposto diretamente) - só o nginx é público. Isso mantém
    # frontend e backend na mesma origem para o navegador (essencial:
    # onrender.com está na Public Suffix List, então dois serviços
    # "algo.onrender.com" diferentes contam como sites diferentes e o
    # cookie de sessão não seria enviado entre eles - ver DEPLOY.md).
    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Ver comentário equivalente em frontend/nginx.conf.template -
    # sem isso, o navegador pode manter uma cópia antiga de JS/CSS em
    # cache por bastante tempo depois de um deploy em produção, mesmo
    # já sendo o cenário mais crítico de acontecer (usuário real de
    # verdade, não só ambiente de teste).
    location ~* \.(js|css)$ {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), payment=()" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
