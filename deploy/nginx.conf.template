server {
    # Render injeta a variável de ambiente PORT dinamicamente - o nginx
    # não lê variáveis de ambiente nativamente, então este valor é
    # substituído em tempo de execução por deploy/start.sh (via
    # envsubst), igual ao BACKEND_INTERNAL_URL do
    # frontend/nginx.conf.template usado no docker-compose local.
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index login.html;

    # O backend roda no mesmo container, escutando só em 127.0.0.1
    # (nunca exposto diretamente) - só o nginx é público. Isso mantém
    # frontend e backend na mesma origem para o navegador (essencial:
    # onrender.com está na Public Suffix List, então dois serviços
    # "algo.onrender.com" diferentes contam como sites diferentes e o
    # cookie de sessão não seria enviado entre eles - ver DEPLOY.md).
    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Ver comentário equivalente em frontend/nginx.conf.template -
    # sem isso, o navegador pode manter uma cópia antiga de JS/CSS em
    # cache por bastante tempo depois de um deploy em produção, mesmo
    # já sendo o cenário mais crítico de acontecer (usuário real de
    # verdade, não só ambiente de teste).
    location ~* \.(js|css)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
