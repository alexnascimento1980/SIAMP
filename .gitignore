# Banco de dados local
*.sqlite3
*.db

# Artefatos gerados por scripts de migração de dados entre ambientes
# (ex.: app.scripts.exportar_catalogos) - específicos de uma
# transferência pontual, não fazem parte do código-fonte do projeto.
database/exportado_*.sql

# Artefatos dos testes E2E (screenshots de falha, cache do Playwright)
e2e/test-results/
e2e/.pytest_cache/

# Memória local do Claude Code - contexto pessoal de quem está
# desenvolvendo, não compartilhado com o repositório (diferente de um
# CLAUDE.md na raiz, que ficaria versionado normalmente). Ver:
# https://docs.claude.com/en/docs/claude-code/memory
CLAUDE.local.md

# Saída do graphify (/graphify) - grafo de conhecimento gerado localmente
# a partir de todo o código-fonte e docs do projeto (graph.json, HTML,
# GRAPH_REPORT.md). Não deve ir para o GitHub: é derivado, pesado, e
# pode reformular informação sensível do repo de um jeito mais fácil
# de vazar sem querer.
graphify-out/